          <mxGeometry x="1205" y="210" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="o_t9" value="&lt;b&gt;Publicar&lt;/b&gt;&lt;br&gt;SWAP RF06 + MERGE RF07 · idempotente por semana_ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1355" y="215" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o_t10" value="&lt;b&gt;Log + aviso&lt;/b&gt;&lt;br&gt;EXECUCAO_LOG = PUBLICADA · e-mail/Teams para IC com resumo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1525" y="215" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o_t11" value="&lt;b&gt;Fim&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1700" y="225" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o_f1" value="Timeout → falha controlada · alerta Eng. Dados 3C · nada publicado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="185" y="380" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o_f2" value="Bloqueio → alerta + relatório RF02 · mantém última RF06 · reexecução manual com justificativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o_f3" value="Falha → não publica · mantém última RF06 válida · alerta A3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1195" y="380" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o_w" value="&lt;b&gt;Detecção de não execução (independe do Airflow)&lt;/b&gt;&lt;br&gt;Snowflake ALERT agendado seg 12h: se não houver run PUBLICADA para a semana_ref em OPS.EXECUCAO_LOG → e-mail via notification integration para A3 e Eng. Dados 3C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="510" width="430" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o_r" value="&lt;b&gt;Execução manual e reprocesso (E§4.4.3)&lt;/b&gt;&lt;br&gt;Parâmetros: semana_ref · mecanicas · modo (normal | dry_run | reprocesso) · usar_snapshot · ignorar_gate_rf02 + justificativa&lt;br&gt;dry_run grava em sandbox e não publica · reprocesso refaz RF07 da semana de forma idempotente · rollback: republicar RF06 a partir da RF07 ou Time Travel · recomendação já enviada a campanha não é alterada (campanha referencia run_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="470" y="510" width="620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o_b" value="&lt;b&gt;DAG reco_benchmark [F1b], separado e manual&lt;/b&gt;&lt;br&gt;EXPORT → COPY INTO S3 us-east-1 → EventBridge → Step Functions (import, treino, lote) → COPY INTO OPS.BENCHMARK_RESULTADO&lt;br&gt;Falha de Step Functions → EventBridge → SNS e-mail · AWS Budgets 50/80/100% · nunca bloqueia o reco_semanal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1110" y="510" width="720" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o_al" value="&lt;b&gt;Alarmes e acionamento&lt;/b&gt; (POC → pós-POC)&lt;br&gt;• Falha de tarefa · on_failure_callback do Airflow → canal 3C (ARQ-Q27) · Alta · Eng. ML A3 em horário comercial → sustentação 3C&lt;br&gt;• Não execução · Snowflake ALERT seg 12h · Alta · A3 + Eng. Dados 3C → sustentação 3C&lt;br&gt;• Dados não prontos · sensor com timeout · Média · Eng. Dados 3C (origem)&lt;br&gt;• Gate RF02 bloqueado · log + relatório · Média · cientista A3, IC informada&lt;br&gt;• Teste de contrato falhou · não publica · Alta · A3&lt;br&gt;• Degradação de qualidade · % PDVs com recomendação, % backoff nacional, cobertura de catálogo, deriva de score · Média · A3&lt;br&gt;• Custo Snowflake · resource monitor 80% aviso, 100% suspende dev · Média · 3C&lt;br&gt;• Benchmark AWS · SNS + Budgets · Média · A3&lt;br&gt;• API F2 · CloudWatch 5xx, latência p95, throttling DynamoDB, erros Lambda · Alta · a definir no ADR de F2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="650" width="1070" height="210" as="geometry" />
        </mxCell>
        <mxCell id="o_sla" value="&lt;b&gt;SLAs (hipóteses a validar: ARQ-Q23, ARQ-Q24)&lt;/b&gt;&lt;br&gt;• Frescor: recomendações da semana S publicadas até seg 12h BRT, se os dados de domingo estiverem no Snowflake até 06h&lt;br&gt;• Duração da DAG: alvo abaixo de 2h no warehouse M (medir em M1)&lt;br&gt;• Disponibilidade de leitura: a do Snowflake da 3C (SWAP evita leitura parcial)&lt;br&gt;• Reprocesso: no mesmo dia útil&lt;br&gt;• F2: herda SLAs de API Gateway, Lambda e DynamoDB; alvo p95 a definir com o B2B&lt;br&gt;&lt;br&gt;&lt;b&gt;Runbook mínimo (entregável A3)&lt;/b&gt;: como reprocessar, como liberar gate com justificativa, como republicar a semana anterior, contatos e matriz de acionamento" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1110" y="650" width="720" height="210" as="geometry" />
        </mxCell>
