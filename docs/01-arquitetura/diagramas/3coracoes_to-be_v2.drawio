          <mxGeometry x="1590" y="170" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s_ctr" value="CloudTrail&lt;br&gt;gestão + eventos de dados do bucket" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="1">
          <mxGeometry x="1760" y="170" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s_ustxt" value="&lt;b&gt;Pseudonimizado não é anônimo&lt;/b&gt;: a 3C mantém o mapa, então o dado continua pessoal e a exportação é transferência internacional. Sem CNPJ, nome, endereço, contato ou vendedor no export. Geografia só até regional. 3 a 6 rodadas, não semanal. Evidência de exclusão ao fim do benchmark." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="320" width="650" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s_tab" value="&lt;b&gt;Controles por tema&lt;/b&gt;&lt;br&gt;• Papel: A3 é operadora (LGPD art. 39); DPA e registro da operação (ARQ-Q34)&lt;br&gt;• Minimização: motor e RF06/RF07 sem CNPJ, nome, contato ou vendedor&lt;br&gt;• Criptografia: Snowflake nativa · S3/DynamoDB com CMK por ambiente · TLS em trânsito&lt;br&gt;• Credenciais: sem chave IAM de longa duração · storage integration por role · key-pair para serviço Snowflake&lt;br&gt;• Acesso humano: IAM Identity Center com MFA e permission sets temporários; contas Snowflake nominais&lt;br&gt;• Retenção: S3 troca 7 dias · Personalize excluído ao fim · RF07, logs e snapshots conforme política 3C (ARQ-Q32)&lt;br&gt;• Auditoria: CloudTrail · histórico de acesso e consultas do Snowflake (por edição, A VERIFICAR)&lt;br&gt;• Exige parecer jurídico: exportação para us-east-1; uso do histórico de MEI para personalização; retenção da RF07" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1170" y="600" width="710" height="200" as="geometry" />
        </mxCell>
        <mxCell id="s_leg" value="&lt;b&gt;Setas&lt;/b&gt;: 1 · bases → masking → motor (SQL interno) · 2 · motor → RF06/RF07 · 3 · mapa + motor → EXPORT (só F1b) · 4 · EXPORT → storage integration → G0 → S3 us-east-1 (COPY INTO, TLS, SSE-KMS) · 5 · RF06 → DynamoDB sa-east-1 (F2, semanal)&lt;br&gt;Verde tracejado: fronteira Brasil · Vermelho tracejado: fora do Brasil · Lilás: controle de segurança · Vermelho: gate/risco" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="780" width="1120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_e1a" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_base" target="s_mask">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
