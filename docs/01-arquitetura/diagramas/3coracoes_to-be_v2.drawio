        <mxCell id="o_tit" value="&lt;b&gt;Projeto:&lt;/b&gt; 3 Corações · Recomendação de SKU (NBO/MBA) B2B&lt;br&gt;&lt;b&gt;Aba:&lt;/b&gt; 5 Operação&lt;br&gt;&lt;b&gt;Versão:&lt;/b&gt; v2 · &lt;b&gt;Data:&lt;/b&gt; 2026-10-26&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; proposto · horários e limiares são hipóteses" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
