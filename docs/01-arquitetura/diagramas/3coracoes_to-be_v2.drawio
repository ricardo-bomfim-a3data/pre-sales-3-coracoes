        </mxCell>
        <mxCell id="c_dash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="&lt;b&gt;Dashboard D-1&lt;/b&gt; (RNF02, 3C)&lt;br&gt;KPIs por mecânica, abertura e grupo A/B" vertex="1">
