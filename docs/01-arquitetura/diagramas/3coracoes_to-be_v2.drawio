          <mxGeometry x="1485" y="150" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f_v2" value="&lt;b&gt;VW_RECO_CRM&lt;/b&gt;&lt;br&gt;público + SKUs por campanha e grupo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1485" y="240" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f_v3" value="&lt;b&gt;VW_COMBOS_REGIONAL&lt;/b&gt;&lt;br&gt;combos por regional/filial para a IC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1485" y="330" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f_v4" value="&lt;b&gt;VW_RESULTADO_AB&lt;/b&gt; (D-1)&lt;br&gt;faturamento · margem · sortimento · frequência · conversão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1485" y="420" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f_v5" value="&lt;b&gt;VW_RELATORIO_PRE_EXECUCAO&lt;/b&gt;&lt;br&gt;RF02 exportável" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1485" y="520" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f_c6" value="&lt;b&gt;Contrato RF06 · OUT.RECOMENDACAO_ATUAL&lt;/b&gt; (nomes A VERIFICAR com padrão 3C)&lt;br&gt;run_id VARCHAR(36) NN · semana_ref DATE NN · dt_geracao TIMESTAMP_TZ NN · tipo_execucao (AGENDADA | MANUAL | REPROCESSO)&lt;br&gt;mecanica (COMBO | MAIS_POR_MENOS | DESCONTO) · grao (PDV_SKU | SKU_PDV | ABERTURA_COMBO)&lt;br&gt;cod_cliente (nulo em ABERTURA_COMBO; CNPJ fica no cadastro) · sku_id NN · sku_ancora_id (combo)&lt;br&gt;canal · regional · filial · uf · capital_interior · area_atuacao&lt;br&gt;qualificacao_sku (NOVO | RECOMPRA | GERAL) · janela_meses (1, 3, 6, 9, 12) · nivel_backoff (FILIAL | REGIONAL | CANAL | NACIONAL)&lt;br&gt;rank SMALLINT NN · score FLOAT NN · score_tipo (PROPENSAO | LIFT | POPULARIDADE) · suporte · confianca · lift&lt;br&gt;estoque_ok BOOLEAN · motor (SNOWPARK | PERSONALIZE | BASELINE) · model_name · model_version · regra_versao&lt;br&gt;grupo_ab (A_CONTROLE | B_ALGORITMO, de OPS.ATRIBUICAO_AB) · campanha_id · valido_de · valido_ate&lt;br&gt;&lt;b&gt;Chave lógica&lt;/b&gt;: semana_ref, mecanica, grao, cod_cliente ou &#39;*&#39;, abertura, sku_ancora_id, sku_id, qualificacao_sku · cluster por (mecanica, regional)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="730" width="1000" height="190" as="geometry" />
        </mxCell>
        <mxCell id="f_c7" value="&lt;b&gt;Contrato RF07 · OUT.RECOMENDACAO_HIST&lt;/b&gt; (SCD tipo 2)&lt;br&gt;colunas de negócio da RF06 + sk_registro (hash da chave, sem semana_ref) · hash_atributos · vigencia_inicio · vigencia_fim (nulo = vigente) · flag_atual · run_id_inicio · run_id_fim&lt;br&gt;&lt;b&gt;Reprocesso idempotente&lt;/b&gt; da mesma semana_ref, numa transação: (a) apaga versões abertas na semana; (b) reabre versões fechadas pela semana; (c) novo MERGE&lt;br&gt;&lt;b&gt;Decisão pendente (ARQ-D05)&lt;/b&gt;: score muda toda semana → SCD2 vira snapshot. Opções: rastrear só (sku, rank, model_version) com score tipo 1, ou snapshot append-only por semana_ref com view SCD" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="940" width="1000" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f_leg" value="&lt;b&gt;Setas (o que trafega · frequência · formato)&lt;/b&gt;&lt;br&gt;1 · Fontes → RF01: SQL, semanal (snapshot por run_id); retorno de campanha diário&lt;br&gt;2 · RF01 → RF02 → RF03 → features: Snowpark DataFrames, mesma execução&lt;br&gt;3 · Features → modelos: tabelas CORE; modelos treinados semanalmente (hipótese)&lt;br&gt;4 · Modelos → pós: scores PDV × SKU e regras por abertura&lt;br&gt;5 · Pós → saída: só publica se testes de contrato passam&lt;br&gt;6 · Saída → views: SELECT pelos consumidores (RECO_READ)&lt;br&gt;&lt;br&gt;&lt;b&gt;Volume (premissa P4, A VERIFICAR)&lt;/b&gt;&lt;br&gt;300 mil PDVs · 500 SKUs · 30 M linhas em 12 meses&lt;br&gt;Saída ≈ PDVs × mecânicas × qualificações × top-N&lt;br&gt;&lt;br&gt;&lt;b&gt;Testes de contrato&lt;/b&gt;: unicidade da chave · rank contínuo · SKU ativo e com estoque · % PDVs sem recomendação abaixo do limiar · variação de contagem vs semana anterior · model_version registrado · grupo_ab coerente" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="730" width="670" height="330" as="geometry" />
        </mxCell>
