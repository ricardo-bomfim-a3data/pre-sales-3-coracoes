        <mxCell id="g_h" value="Recomendação de SKU para o B2B da 3 Corações · visão geral da solução proposta" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g_tit" value="&lt;b&gt;Projeto:&lt;/b&gt; 3 Corações · Recomendação de SKU B2B&lt;br&gt;&lt;b&gt;Aba:&lt;/b&gt; 1 Visão geral · &lt;b&gt;Versão:&lt;/b&gt; v3.1 · &lt;b&gt;Data:&lt;/b&gt; 2026-10-26&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; proposta de pré-vendas; nada existe ainda além dos sistemas da 3C" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="10" width="400" height="70" as="geometry" />
        </mxCell>
