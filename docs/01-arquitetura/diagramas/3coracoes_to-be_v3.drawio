        </mxCell>
        <mxCell id="t_prep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;Preparação dos dados&lt;/b&gt;&lt;br&gt;foto semanal da entrada · relatório de qualidade antes de rodar (volumes, nulos, chaves) · filtros: só itens com estoque, exclui o que o cliente já comprou no mês" vertex="1">
          <mxGeometry height="120" width="300" x="620" y="160" as="geometry" />
