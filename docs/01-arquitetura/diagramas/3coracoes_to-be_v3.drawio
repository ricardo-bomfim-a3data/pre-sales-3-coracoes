        <mxCell id="g_sap" value="&lt;b&gt;SAP&lt;/b&gt;&lt;br&gt;pedidos, faturamento, clientes, produtos, estoque" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g_sf" value="&lt;b&gt;Snowflake&lt;/b&gt;&lt;br&gt;dados analíticos e Feature Store de Clientes (visão 360°) · região a confirmar" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="140" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g_af" value="&lt;b&gt;Airflow&lt;/b&gt;&lt;br&gt;agendador de rotinas da 3C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="150" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g_ic" value="&lt;b&gt;Inteligência Comercial&lt;/b&gt;&lt;br&gt;hoje escolhe itens e público das ofertas manualmente e passa pela aprovação de preço" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="890" y="150" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g_canais" value="&lt;b&gt;Canais de venda&lt;/b&gt;&lt;br&gt;Sírius (app do vendedor) e e-commerce B2B, com as três mecânicas: combos, mais por menos, desconto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1190" y="150" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g_sfc" value="&lt;b&gt;Salesforce e BI atual&lt;/b&gt;&lt;br&gt;registro das campanhas e painéis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1510" y="150" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g_znew" value="O que a A3 constrói na fase 1 (meses 1 a 3), dentro do Snowflake e do Airflow da 3C · atende os itens 4.4.1 a 4.4.3 da especificação · nenhum dado sai do Snowflake da 3C" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F7FBFF;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="340" width="1760" height="230" as="geometry" />
        </mxCell>
        <mxCell id="g_n1" value="&lt;b&gt;1 · Preparação dos dados&lt;/b&gt;&lt;br&gt;lê vendas, clientes, produtos e estoque; gera relatório de qualidade; aplica filtros (só itens com estoque, exclui o que o cliente já comprou no mês)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="400" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g_n2" value="&lt;b&gt;2 · Modelos de recomendação&lt;/b&gt; (notebooks e código Python no Snowflake)&lt;br&gt;&lt;b&gt;Cesta de compras&lt;/b&gt; (itens comprados juntos) → combos&lt;br&gt;&lt;b&gt;Próxima melhor oferta&lt;/b&gt; (por cliente) → desconto e mais por menos&lt;br&gt;por canal, região, área do vendedor e janela de tempo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="400" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g_n3" value="&lt;b&gt;3 · Tabelas de recomendação&lt;/b&gt;&lt;br&gt;recomendações da semana (uma linha por cliente, item e mecânica, com nota e motivo) e histórico de todas as semanas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="400" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g_n4" value="&lt;b&gt;4 · Teste A/B e painel diário&lt;/b&gt;&lt;br&gt;metade dos clientes recebe a oferta recomendada, metade segue o processo atual; medição diária de faturamento, margem, sortimento, frequência e conversão no BI atual da 3C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="400" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g_n5" value="&lt;b&gt;Rotina semanal&lt;/b&gt; no Airflow&lt;br&gt;executa 1 → 2 → 3 toda semana; também pode ser disparada à mão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1510" y="400" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g_zaws" value="O que a A3 constrói na fase 2 (meses 3 a 5), na conta AWS da 3C, região N. Virgínia nos EUA · só cópias sem dados pessoais · somente após parecer jurídico" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF8F0;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="1760" height="200" as="geometry" />
        </mxCell>
        <mxCell id="g_a1" value="&lt;b&gt;5 · Cópia semanal das recomendações e da medição&lt;/b&gt;&lt;br&gt;sem nome, CPF ou contato; CNPJ substituído por código" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="670" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="g_a2" value="&lt;b&gt;6 · Catálogo e visões de negócio&lt;/b&gt;&lt;br&gt;tabelas com nomes de negócio e permissões por coluna, definidas uma vez para painéis e assistente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="670" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="g_a3" value="&lt;b&gt;7 · Painéis e assistente para a Inteligência Comercial&lt;/b&gt;&lt;br&gt;painéis semanais do teste A/B com perguntas em linguagem natural; assistente que explica cada recomendação e monta a lista de campanha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="670" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="g_a4" value="&lt;b&gt;8 · Modelo alternativo para comparação&lt;/b&gt;&lt;br&gt;Amazon Personalize treinado com histórico sem identificação; comparado em laboratório com o modelo da fase 1; só entra em campanha se vencer e por decisão da 3C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="670" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="g_gate" value="&lt;b&gt;Parecer jurídico&lt;/b&gt;&lt;br&gt;condição para toda esta faixa (ver aba 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
