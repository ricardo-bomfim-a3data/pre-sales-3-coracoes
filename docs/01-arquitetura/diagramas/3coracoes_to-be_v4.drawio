        </mxCell>
        <mxCell id="v4-d1t_glue2" value="&lt;b&gt;Glue · saídas&lt;/b&gt;&lt;br&gt;junta NBO e cesta, aplica o filtro final (estoque, já comprado; pede mais itens que o top-N) e grava o arquivo de sucesso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;align=left;spacingLeft=66;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1">
