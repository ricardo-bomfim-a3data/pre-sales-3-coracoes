        <mxCell id="v4-d1t_sm" value="&lt;b&gt;SageMaker AI · cesta (MBA)&lt;/b&gt;&lt;br&gt;job com regras de associação, independente do NBO; notebooks de desenvolvimento; desafiante de NBO opcional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;align=left;spacingLeft=66;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1">
