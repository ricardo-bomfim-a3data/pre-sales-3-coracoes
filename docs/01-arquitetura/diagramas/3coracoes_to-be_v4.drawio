        </mxCell>
        <mxCell id="v4-d1t_pers" value="&lt;b&gt;Personalize · NBO&lt;/b&gt;&lt;br&gt;duas soluções: desconto (por cliente) e mais por menos (afinidade com item); regional por filtro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;align=left;spacingLeft=66;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1">
