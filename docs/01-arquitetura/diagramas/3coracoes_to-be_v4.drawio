        <mxCell id="v4-d2t_n_acc" value="&lt;b&gt;Acessos&lt;/b&gt;&lt;br&gt;papel de exportação só com as visões de exportação · equipe A3 com acesso nominal aos dados reais, sob contrato de operador · leitores só nas visões" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
