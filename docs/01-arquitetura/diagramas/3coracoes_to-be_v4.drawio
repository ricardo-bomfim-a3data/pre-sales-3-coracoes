  <diagram name="5 Dados, acesso e retenção" id="v4-dados">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v4-dados_title" value="Dados, acesso e retenção · vale para os dois desenhos" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v4-dados_info" value="&lt;b&gt;Projeto:&lt;/b&gt; 3 Corações · Recomendação de SKU B2B&lt;br&gt;&lt;b&gt;Aba:&lt;/b&gt; 5 Dados, acesso e retenção · &lt;b&gt;Versão:&lt;/b&gt; v4.0 · &lt;b&gt;Data:&lt;/b&gt; 2026-10-27&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; proposto · v4.1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1460" y="10" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v4-dados_n_c1" value="&lt;b&gt;O que fica onde&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Snowflake da 3C (sistema de registro, sem prazo):&lt;/b&gt;&lt;br&gt;• dados de origem do SAP&lt;br&gt;• histórico de recomendações, grupos do teste, exposição e medição&lt;br&gt;• foto versionada (clone) dos dados de treino de cada rodada, para reproduzir qualquer resultado&lt;br&gt;• tabelas entregues à Inteligência Comercial&lt;br&gt;&lt;br&gt;&lt;b&gt;AWS (cópia de trabalho):&lt;/b&gt;&lt;br&gt;• arquivos de entrada e de saída de cada rodada, por 30 dias (regra de ciclo de vida do S3)&lt;br&gt;• dados do Personalize, enquanto o modelo estiver ativo; removidos ao desativar&lt;br&gt;• artefatos sem dado pessoal, sem prazo: métricas, versões de modelo, regras de cesta (só itens) e logs de auditoria&lt;br&gt;&lt;br&gt;&lt;b&gt;Por que não há datamart na AWS (Desenho 1):&lt;/b&gt; o histórico já vive no Snowflake. Guardar na AWS duplicaria dado fora do país, custo e superfície de risco. No Desenho 2 o histórico do teste passa a viver na AWS e a retenção precisa ser definida." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="600" height="600" as="geometry" />
        </mxCell>
        <mxCell id="v4-dados_n_c2" value="&lt;b&gt;Acesso rigoroso (dados reais com código do cliente)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;o código do cliente do SAP substitui o CNPJ nas cópias&lt;/b&gt; (decisão de 27/10): o motor não precisa do CNPJ, e isso reduz a exposição de MEI (microempreendedor) e empresa individual; o CNPJ fica só no Snowflake&lt;br&gt;• acesso nominal por papel, sem usuário compartilhado, com verificação em duas etapas e login corporativo da 3C&lt;br&gt;• papéis separados: pipeline (sem acesso humano), desenvolvedor A3, leitor, auditor da 3C&lt;br&gt;• &lt;b&gt;a equipe da A3 trabalha com os dados reais por enquanto&lt;/b&gt; (decisão de 27/10), com acesso nominal, registrado no CloudTrail e revisado pela 3C, sob contrato de operador; o Step Functions trafega só caminhos de arquivos&lt;br&gt;• chave de criptografia (KMS) da 3C, administrada pela 3C&lt;br&gt;• S3 sem acesso público; acesso por endpoint privado para o pipeline, com exceções por papel para o Personalize e para a integração do Snowflake, que não passam pela rede privada da 3C&lt;br&gt;• CloudTrail com eventos de dados do S3 e alarme de acesso fora do padrão&lt;br&gt;• no Snowflake: integração de armazenamento com papel de menor privilégio e papel de exportação separado&lt;br&gt;• revisão trimestral de acessos pela 3C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="600" height="600" as="geometry" />
        </mxCell>
        <mxCell id="v4-dados_n_c3" value="&lt;b&gt;Qual é o papel da A3 aqui&lt;/b&gt;&lt;br&gt;&lt;br&gt;A A3 é &lt;b&gt;operadora&lt;/b&gt; dos dados da 3C, sob contrato de operador (a assinar no mês 1).&lt;br&gt;&lt;br&gt;&lt;b&gt;A A3 faz:&lt;/b&gt;&lt;br&gt;• desenha e constrói as tabelas, as visões e os jobs&lt;br&gt;• escreve o código de preparação, exportação, modelos e carga de volta&lt;br&gt;• opera a rodada semanal e investiga falhas, usando contagens e relatórios de qualidade&lt;br&gt;• entrega o dicionário de dados e a documentação&lt;br&gt;&lt;br&gt;&lt;b&gt;A 3C faz:&lt;/b&gt;&lt;br&gt;• é dona e controladora dos dados&lt;br&gt;• cria a integração de armazenamento e os papéis no Snowflake e na conta AWS&lt;br&gt;• define a retenção, autoriza exportações e revisa acessos&lt;br&gt;• carrega a exposição das campanhas e, no futuro, as vendas diárias&lt;br&gt;&lt;br&gt;&lt;b&gt;Regra de trabalho:&lt;/b&gt; a equipe da A3 trabalha com os dados reais, com acesso nominal e registrado, sob o contrato de operador; usa só o que a rodada precisa e não copia dados para fora dos ambientes da 3C." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="110" width="620" height="600" as="geometry" />
        </mxCell>
        <mxCell id="v4-dados_n_d1" value="&lt;b&gt;Retenção · decisões&lt;/b&gt;: 30 dias para arquivos na AWS (era 7 dias na proposta anterior; ajustável com o encarregado de dados da 3C) · dados do Personalize apagados ao desativar o modelo · histórico completo no Snowflake, sem prazo, definido pela 3C · artefatos sem dado pessoal e logs de auditoria sem prazo, com custo baixo. Se o histórico passar a ser útil também para outros projetos, o lugar dele é um datamart no Snowflake, não na AWS." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="730" width="1860" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v4-dados_n_d2" value="&lt;b&gt;Em aberto&lt;/b&gt;: (1) o código do cliente é uma chave que a 3C consegue ligar ao CNPJ: continua sendo dado pessoal quando o cliente é pessoa física; reavaliar se o encarregado de dados (DPO) da 3C exigir pseudonimização adicional. (2) MEI e empresa individual nas cópias, agora com menos exposição. (3) posição jurídica sobre os dados fora do país: a expectativa é de que não haja impedimento, mas ela não foi verificada, e nenhum dado real sai antes da resposta (ARQ-Q43). (4) região do Snowflake da 3C e se a organização AWS da 3C bloqueia regiões (política SCP). (5) preço das ferramentas na calculadora da AWS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="880" width="1860" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6 Fases e decisões" id="v4-fases">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v4-fases_title" value="Fases, decisões e o que mudou em relação à v3" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v4-fases_info" value="&lt;b&gt;Projeto:&lt;/b&gt; 3 Corações · Recomendação de SKU B2B&lt;br&gt;&lt;b&gt;Aba:&lt;/b&gt; 6 Fases e decisões · &lt;b&gt;Versão:&lt;/b&gt; v4.0 · &lt;b&gt;Data:&lt;/b&gt; 2026-10-27&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; proposto · v4.1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1460" y="10" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v4-fases_n_f0" value="&lt;b&gt;Pré-contrato&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Sírius aceita SKU diferente por cliente na mesma campanha? (define o grão do NBO e do A/B)&lt;br&gt;• quem analisa o resultado se a 1ª campanha só entrar em M3?&lt;br&gt;• há congelamento de TI entre dezembro e janeiro?&lt;br&gt;• aceite por escrito da 3C: motor na AWS (itens 4.1, 4.3.1.2, 4.4.1 a 4.4.3, RNF04 e a API do mês 3)&lt;br&gt;• contrato de operador 3C e A3&lt;br&gt;• posição do jurídico e do encarregado de dados sobre dados de clientes fora do país (código do cliente no lugar do CNPJ)&lt;br&gt;• funding: o mínimo de R$ 50 mil é piso rígido? a projeção pode incluir outras cargas da 3C?&lt;br&gt;• organização AWS da 3C: regiões liberadas&lt;br&gt;• dia e hora da carga semanal; data da carga diária&lt;br&gt;• volume de dados: histórico, clientes, itens, pedido por item" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="440" height="420" as="geometry" />
        </mxCell>
        <mxCell id="v4-fases_n_f1" value="&lt;b&gt;Fase 1 · meses 1 a 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;• carga e preparação no Snowflake, relatório de qualidade&lt;br&gt;• &lt;b&gt;piso&lt;/b&gt;: recomendação por popularidade e cesta em SQL no Snowflake, como régua offline e plano de contingência&lt;br&gt;• exportação para o S3 e pipeline na AWS: Glue, Personalize (2 soluções), SageMaker AI, Step Functions&lt;br&gt;• escolha única da janela de tempo do Personalize e registro da decisão&lt;br&gt;• primeira rodada semanal completa, com as tabelas devolvidas ao Snowflake&lt;br&gt;• grupos do teste A/B e registro de exposição&lt;br&gt;• painel diário no BI atual da 3C&lt;br&gt;• &lt;b&gt;decisão E ou D até o fim do mês 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="110" width="440" height="420" as="geometry" />
        </mxCell>
        <mxCell id="v4-fases_n_f2" value="&lt;b&gt;Fase 2 · meses 3 a 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;• campanhas com teste A/B nas três mecânicas&lt;br&gt;• ajuste dos modelos com o resultado: filtros, pesos e regras de cesta&lt;br&gt;• desafiante de NBO no SageMaker AI, se houver tempo&lt;br&gt;• medição por grupo e relatório de resultado&lt;br&gt;• transferência de conhecimento para a 3C&lt;br&gt;• análise final até 4 semanas depois do mês 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="110" width="440" height="420" as="geometry" />
        </mxCell>
        <mxCell id="v4-fases_n_f3" value="&lt;b&gt;Evolução (6 a 12 meses)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• recomendação em tempo real, só com consumidor pronto (Sírius em visita, home do B2B); o Personalize cobra um mínimo contínuo por campanha ativa&lt;br&gt;• mais filiais e famílias&lt;br&gt;• retreino e monitoramento de deriva&lt;br&gt;• Desenho 2, se a 3C aceitar a AWS como sistema de registro do teste&lt;br&gt;• decisão por ADR quando houver consumidor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="110" width="480" height="420" as="geometry" />
        </mxCell>
        <mxCell id="v4-fases_n_g" value="&lt;b&gt;O que mudou em relação à v3&lt;/b&gt;: o Quick, o Bedrock e o Redshift saíram do desenho · o motor agora é Personalize (NBO e mais por menos) e SageMaker AI (cesta), com o Glue só como apoio · o Step Functions orquestra, o manifesto no S3 o aciona e o Airflow só agenda e carrega · toda a AWS fica em us-east-1, sem divisão com São Paulo · o código do cliente do SAP vai para a AWS no lugar do CNPJ, com controle de acesso rigoroso, e a A3 trabalha com os dados reais · retenção de 30 dias nos arquivos da AWS e histórico sem prazo no Snowflake · há dois desenhos: o 1 (oficial, controle do teste no Snowflake) e o 2 (controle também na AWS, com Grafana no painel)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="1860" height="190" as="geometry" />
        </mxCell>
        <mxCell id="v4-fases_n_h" value="&lt;b&gt;Pontos de decisão&lt;/b&gt;: (1) aceite da 3C para o motor na AWS, antes do contrato · (2) fim do mês 1: primeira rodada completa com qualidade de dados aceita, e decisão entre o motor na AWS (E) e no Snowflake (D) com base no piso e no desempenho offline · (3) fim do mês 3: primeira campanha no ar · (4) fim do mês 5: resultado do teste A/B e decisão sobre produção em tempo real. &lt;b&gt;Funding&lt;/b&gt;: a AWS paga 10% do consumo anual projetado da produção, na conta da 3C; o mínimo de R$ 50 mil de repasse pede cerca de US$ 7,6 mil por mês de consumo, contra US$ 1,0 a 1,4 mil da produção base (seção 8.7 de arquitetura-proposta.md)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="780" width="1860" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="7 POC para o funding" id="v4-poc">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v4-poc_title" value="POC (prova de valor) para o funding · o Desenho 1 em escala menor, com resultado medido offline" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_info" value="&lt;b&gt;Projeto:&lt;/b&gt; 3 Corações · Recomendação de SKU B2B&lt;br&gt;&lt;b&gt;Aba:&lt;/b&gt; 7 POC para o funding · &lt;b&gt;Versão:&lt;/b&gt; v4.0 · &lt;b&gt;Data:&lt;/b&gt; 2026-10-27&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; proposto · v4.2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1460" y="10" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_zs" value="Snowflake da 3C · recorte do piloto" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F7FBFF;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="1860" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_p1" value="&lt;b&gt;Recorte do piloto&lt;/b&gt;&lt;br&gt;1 filial e 1 a 2 famílias de produto; 12 meses de histórico por cliente e item; código do cliente do SAP no lugar do CNPJ; foto versionada dos dados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_p2" value="&lt;b&gt;Visões de exportação e manifesto&lt;/b&gt;&lt;br&gt;histórico de compras, itens e estoque; papel de exportação separado; disparo à mão (o Airflow entra só na produção)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="150" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_za" value="AWS · conta da 3C · N. Virgínia (us-east-1) · custo do piloto em torno de US$ 300 a 600 por mês" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="1860" height="330" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_zf" value="Step Functions · orquestra o preparo, o NBO, a cesta e a saída" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_step_functions_workflow;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="340" width="800" height="290" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_s3in" value="&lt;b&gt;S3 · entrada&lt;/b&gt;&lt;br&gt;visões exportadas, criptografadas com chave da 3C; apagadas em 30 dias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;fontSize=11;align=left;spacingLeft=66;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="370" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_s3in_ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="570" y="396" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_glue1" value="&lt;b&gt;Glue · preparo&lt;/b&gt;&lt;br&gt;arquivos do Personalize e tabela de pedidos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;align=left;spacingLeft=66;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="370" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_glue1_ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="1">
          <mxGeometry x="1090" y="396" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_pers" value="&lt;b&gt;Personalize · NBO&lt;/b&gt;&lt;br&gt;desconto e mais por menos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;align=left;spacingLeft=66;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1340" y="370" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_pers_ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.personalize;" vertex="1" parent="1">
          <mxGeometry x="1350" y="396" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_sm" value="&lt;b&gt;SageMaker AI · cesta&lt;/b&gt;&lt;br&gt;regras de associação (MBA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01A88D;strokeWidth=2;fontSize=11;align=left;spacingLeft=66;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1600" y="370" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_sm_ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sagemaker;" vertex="1" parent="1">
          <mxGeometry x="1610" y="396" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_glue2" value="&lt;b&gt;Glue · saídas&lt;/b&gt;&lt;br&gt;junta NBO e cesta; filtro final; arquivo de sucesso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;align=left;spacingLeft=66;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1600" y="510" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_glue2_ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="1">
          <mxGeometry x="1610" y="536" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_n_cost" value="&lt;b&gt;Custo da POC&lt;/b&gt;: cenário A da seção 8.6 de arquitetura-proposta.md, cerca de US$ 1,2 a 2,4 mil no piloto inteiro (3 a 4 meses). O Personalize tem franquia gratuita nos 2 primeiros meses. Valores a confirmar na calculadora da AWS." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_n_sec" value="&lt;b&gt;Segurança&lt;/b&gt;: papéis nominais, chave de criptografia da 3C, bucket sem acesso público, CloudTrail; a A3 trabalha com os dados reais sob contrato de operador (aba 5)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_zr" value="Resultado da POC · o que se leva ao cliente e à AWS" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5FFF5;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="670" width="1860" height="190" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_r2" value="&lt;b&gt;Tabelas no Snowflake&lt;/b&gt;&lt;br&gt;recomendações, regras de cesta e métricas, carregadas da AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1600" y="720" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v4-poc_r1" value="&lt;b&gt;Comparação offline&lt;/b&gt;&lt;br&gt;acerto nos 10 primeiros, cobertura do catálogo e ganho sobre o piso (popularidade e cesta em SQL), por mecânica; critério combinado antes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="720" width="340" height="120" as="geometry" />
        </mxCell>
