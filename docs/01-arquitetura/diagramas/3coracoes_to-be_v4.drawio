        </mxCell>
        <mxCell id="v4-d1t_s3out_ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="1210" y="436" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v4-d1t_n_sec" value="&lt;b&gt;Acesso e chaves&lt;/b&gt;&lt;br&gt;papéis nominais com menor privilégio, verificação em duas etapas, chave de criptografia da 3C, bucket sem acesso público; exceções por papel só para o Personalize e a integração do Snowflake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="550" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-d1t_n_ret2" value="&lt;b&gt;Retenção na AWS&lt;/b&gt;&lt;br&gt;arquivos 30 dias; dados do Personalize enquanto o modelo estiver ativo; métricas, regras de cesta, versões de modelo e logs sem prazo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1560" y="550" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-d1t_n_aud" value="&lt;b&gt;Auditoria e custo&lt;/b&gt;&lt;br&gt;CloudTrail com eventos de dados do S3, alarme de acesso fora do padrão e alerta de gasto (Budgets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1920" y="550" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-d1t_n_leg" value="&lt;b&gt;Como ler&lt;/b&gt;: setas numeradas de 1 a 14 seguem a rodada semanal; as sem número são apoio. Grupos, exposição, medição e painel do teste A/B ficam no Snowflake e no BI da 3C. A AWS só calcula as recomendações e devolve as tabelas por arquivos no S3. Se a 3C carregar as vendas todo dia, só o parâmetro da exportação muda." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="690" width="1020" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v4-d1t_n_pre" value="&lt;b&gt;Pré-requisitos&lt;/b&gt;: (1) aceite por escrito da 3C para o motor rodar na AWS, cobrindo os itens 4.1, 4.3.1.2, 4.4.1 a 4.4.3 e RNF04 da especificação e a API prometida no mês 3 da proposta; (2) contrato de operador 3C e A3 no mês 1; (3) integração de armazenamento criada pela 3C no Snowflake; (4) critério de funding confirmado pela AWS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="830" width="1020" height="100" as="geometry" />
        </mxCell>
