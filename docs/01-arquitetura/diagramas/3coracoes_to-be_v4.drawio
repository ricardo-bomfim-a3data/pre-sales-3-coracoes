        </mxCell>
        <mxCell id="v4-d1t_glue2_ic" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="1">
          <mxGeometry x="1570" y="436" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v4-d1t_s3out" value="&lt;b&gt;S3 · saída&lt;/b&gt;&lt;br&gt;arquivos prontos para a carga e o arquivo de sucesso; apagados em 30 dias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;strokeWidth=2;fontSize=11;align=left;spacingLeft=66;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1">
