      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v4-comp_title" value="Dois desenhos para a mesma entrega · o Desenho 1 é o oficial" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_info" value="&lt;b&gt;Projeto:&lt;/b&gt; 3 Corações · Recomendação de SKU B2B&lt;br&gt;&lt;b&gt;Aba:&lt;/b&gt; 1 Comparativo · &lt;b&gt;Versão:&lt;/b&gt; v4.0 · &lt;b&gt;Data:&lt;/b&gt; 2026-10-27&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; proposto · v4.1 revisada pelo especialista" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1460" y="10" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_h0" value="&lt;b&gt;Função&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="360" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_h1" value="&lt;b&gt;Desenho 1 · oficial&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_h2" value="&lt;b&gt;Desenho 2 · alternativa com as funções de controle na AWS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="100" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a0" value="&lt;b&gt;Motor da próxima melhor oferta (NBO) e do mais por menos&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="156" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b0" value="Amazon Personalize: receita por cliente para o desconto e receita de afinidade com item para o mais por menos, em lote toda semana; região e área por filtro; estoque e &quot;já comprado&quot; conferidos de novo na saída" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="156" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c0" value="Igual ao Desenho 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="156" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a1" value="&lt;b&gt;Motor da cesta de compras (MBA)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="252" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b1" value="SageMaker AI: job de processamento que calcula as regras de associação (suporte, confiança e lift) dos itens comprados juntos; notebooks de desenvolvimento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="252" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c1" value="Igual ao Desenho 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="252" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a2" value="&lt;b&gt;Papel do Glue&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="348" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b2" value="Apoio: prepara os arquivos de entrada e formata as saídas dos dois motores, com o filtro final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="348" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c2" value="Apoio ampliado: também sorteia os grupos A/B, calcula a medição e mantém o catálogo das tabelas de controle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="348" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a3" value="&lt;b&gt;Orquestração&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="444" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b3" value="Step Functions orquestra a AWS; o arquivo de manifesto no S3 aciona o Step Functions; o Airflow da 3C só agenda, espera o arquivo de sucesso no S3 e carrega as tabelas (sem credencial AWS no Airflow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="444" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c3" value="Igual ao Desenho 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="444" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a4" value="&lt;b&gt;Grupos do teste A/B&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="540" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b4" value="Tabela no Snowflake; rotina escrita pela A3 sorteia na rodada, fixa por campanha e registra as trocas manuais da Inteligência Comercial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c4" value="Tabela em formato aberto (Iceberg) no catálogo do Glue; o sorteio roda num job, uma vez por campanha; o grupo segue como coluna na tabela entregue ao Snowflake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="540" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a5" value="&lt;b&gt;Registro de quem recebeu a oferta&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="636" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b5" value="Snowflake, por carga feita pela 3C (hipótese: hoje o Sírius não registra a exposição, ARQ-Q21)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="636" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c5" value="Chega ao Snowflake por carga da 3C, como no Desenho 1, e segue para o S3 na exportação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="636" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a6" value="&lt;b&gt;Medição do teste A/B&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="732" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b6" value="SQL no Snowflake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="732" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c6" value="Athena sobre as tabelas de controle no S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="732" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a7" value="&lt;b&gt;Painel diário (dono: 3C)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="828" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b7" value="BI atual da 3C lendo o Snowflake, sem novo custo de ferramenta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="828" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c7" value="Amazon Managed Grafana lendo o Athena, com login corporativo; atende o painel, mas é uma ferramenta nova para a 3C operar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="828" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a8" value="&lt;b&gt;Tabelas entregues à Inteligência Comercial&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="924" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b8" value="Snowflake: recomendação da semana, histórico e regras de cesta (como a especificação pede)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="924" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c8" value="Snowflake, por carga de volta da AWS (a entrega continua atendendo a especificação)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="924" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a9" value="&lt;b&gt;O que fica na AWS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="1020" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b9" value="Entradas e saídas de cada rodada por 30 dias; conjunto de dados do Personalize enquanto o modelo estiver ativo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="1020" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c9" value="O mesmo, mais as tabelas de controle (grupos, exposição, medição): o histórico do teste passa a viver na AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1020" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a10" value="&lt;b&gt;Vendas do SAP&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="1116" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b10" value="Só no Snowflake; exportação semanal para a AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="1116" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c10" value="No Snowflake e no S3; semanal hoje, diária quando a 3C entregar a nova carga (basta trocar o parâmetro)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1116" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a11" value="&lt;b&gt;Aderência à especificação da 3C&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="1212" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b11" value="Motor na AWS exige aceite por escrito da 3C (itens 4.1, 4.3.1.2, 4.4.1 a 4.4.3 e RNF04); controle e entrega seguem no Snowflake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="1212" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c11" value="Desvio maior: o controle do teste também sai do Snowflake; exige aceite mais amplo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1212" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a12" value="&lt;b&gt;Consumo e custo na AWS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="1308" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b12" value="Menor: S3, Glue, Personalize (duas soluções), SageMaker AI, Step Functions, chaves de criptografia e auditoria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="1308" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c12" value="Maior: soma Athena, Grafana, mais Glue e S3 (valores a confirmar na calculadora da AWS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1308" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a13" value="&lt;b&gt;Principais riscos&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="1404" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b13" value="Entrega semanal passa a depender da AWS; custo de saída de dados do Snowflake; aceite da 3C; Personalize pode não cobrir bem filtros e o &quot;já comprado&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="1404" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c13" value="Dois sistemas de registro; Grafana depende do Athena; exposição e vendas precisam chegar ao S3 com a mesma qualidade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1404" width="760" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_a14" value="&lt;b&gt;Quando escolher&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="1500" width="360" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_b14" value="Caminho oficial, para contratar e executar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="1500" width="700" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v4-comp_n_c14" value="Alternativa, se a 3C aceitar a AWS como sistema de registro do teste e quiser menos dependência do BI atual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1500" width="760" height="84" as="geometry" />
        </mxCell>
      </root>
